name: Build APK

on:
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17

      - name: Ekstrak zip
        run: |
          for z in *.zip; do [ -f "$z" ] && unzip -o "$z"; done
          ls

      - name: Cek berkas
        run: |
          test -d www || { echo "Folder www/ tidak ada di repo"; exit 1; }
          test -f android-widget/add-widget.py || { echo "Folder android-widget/ tidak ada di repo"; exit 1; }

      - name: Siapkan Capacitor
        run: |
          [ -f package.json ] || npm init -y
          npm install @capacitor/core@6 @capacitor/cli@6 @capacitor/android@6 \
            @capacitor/local-notifications@6 @capacitor/share@6 @capacitor/filesystem@6 @capacitor/app@6
          if [ ! -f capacitor.config.json ] && [ ! -f capacitor.config.ts ]; then
            cat > capacitor.config.json <<'EOF'
          {
            "appId": "com.nurtime.app",
            "appName": "NurTime",
            "webDir": "www"
          }
          EOF
          fi
          [ -d android ] || npx cap add android
          npx cap sync android

      - name: Suara adzan dan ikon notifikasi
        run: |
          RES=android/app/src/main/res
          mkdir -p $RES/raw $RES/drawable
          cp www/adzan.mp3 $RES/raw/adzan.mp3
          cat > $RES/drawable/ic_stat_nurtime.xml <<'EOF'
          <vector xmlns:android="http://schemas.android.com/apk/res/android"
              android:width="24dp" android:height="24dp"
              android:viewportWidth="24" android:viewportHeight="24">
              <path android:fillColor="#FFFFFF"
                  android:pathData="M12,3a9,9 0,1 0,9 9c0,-0.46 -0.04,-0.92 -0.1,-1.36a5.39,5.39 0,0 1,-4.4 2.26a5.4,5.4 0,0 1,-5.4 -5.4c0,-1.81 0.89,-3.42 2.26,-4.4C12.92,3.04 12.46,3 12,3z"/>
          </vector>
          EOF

      - name: Pasang widget
        run: python3 android-widget/add-widget.py

      - name: Build APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: NurTime-APK
          path: android/app/build/outputs/apk/debug/*.apk
